-                None
+    fn open(owner: Option<HWND>) -> Option<Self> {
+        // HERDR: clipboard managers can briefly hold the clipboard after a copy.
+        // Bound the wait to 250 ms so a stuck owner cannot hang the UI.
+        for attempt in 0..=25 {
+            match unsafe { OpenClipboard(owner) } {
+                Ok(()) => return Some(Self),
+                Err(e) if attempt == 25 => {
+                    log::error!("Failed to open clipboard: {e}");
+                    return None;
+                }
+                Err(_) => std::thread::sleep(std::time::Duration::from_millis(10)),
             }
         }
+        None
     }
 }
 
